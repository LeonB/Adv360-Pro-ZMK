manifest:
  remotes:
    - name: zmkfirmware
      url-base: https://github.com/zmkfirmware
    - name: refil
      url-base: https://github.com/refil
    - name: leonb
      url-base: https://github.com/LeonB
    - name: urob
      url-base: https://github.com/urob
  projects:
